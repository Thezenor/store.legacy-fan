# ─────────────────────────────────────────────────────────────
# Legacy Fan — variables de entorno (copiar a .env y rellenar)
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Legacy Fan

# Base de datos (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/legacyfan?schema=public"

# Auth.js (NextAuth)
# Generar con: openssl rand -base64 32
AUTH_SECRET="change-me-please"
AUTH_URL=http://localhost:3000

# ── Pasarelas de pago ──
# PayPal ACTIVO desde inicio
PAYMENTS_PAYPAL_ENABLED=true
PAYPAL_MODE=sandbox            # sandbox | live
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Stripe PREPARADO pero DESACTIVADO
PAYMENTS_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Email (Resend inicial) ──
EMAIL_PROVIDER=resend          # resend | brevo | console
RESEND_API_KEY=""
EMAIL_FROM="Legacy Fan <no-reply@legacy-fan.com>"

# ── Seguridad / infraestructura ──
RATE_LIMIT_ENABLED=true

# Superadmin: emails con acceso a /lf-admin antes de asignar roles en BD
SUPERADMIN_EMAILS=""
